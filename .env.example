# OpenCLAW Social — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it contains secrets.

# ── LLM Providers ───────────────────────────────────────────────────────────
# Anthropic — used by Writer (Haiku) and Editor (Sonnet)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# DeepSeek — used by Orchestrator and Researcher (~3-4x cheaper than Haiku)
# Get your key at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── Telegram Integration ─────────────────────────────────────────────────────
# Bot token: create a bot via @BotFather on Telegram, then /newbot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Group chat ID (negative integer for group chats).
# How to find it:
#   1. Send a message in your group
#   2. Visit: https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
#   3. Look for chat.id in the response
TELEGRAM_GROUP_ID=-1001234567890

# ── Optional: Additional Providers ──────────────────────────────────────────
# Uncomment to enable fallback models from other providers
# OPENAI_API_KEY=your_openai_api_key
